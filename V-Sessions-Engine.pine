//@version=6
indicator('V-Sessions', overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

type SessionState
	box sessionBox
	label sessionLabel
	line pocLine
	box lvnBox
	float sHigh
	float sLow
	int startBarIndex
	int startTime
	bool wasInSession
	array<float> ltfH
	array<float> ltfL
	array<float> ltfV

type LVN_Data
	box id
	float top
	float bottom
	bool isMitigated
	bool sessionHist

master_hist = input.bool(false, 'Historical Data (All Sessions)', group = 'SESSION CONFIGURATION', tooltip = 'Disabling this hides past sessions and POCs, leaving only unmitigated LVNs and the active session visible')

sL = input.bool(true, '', inline = 's1_row', group = 'SESSION CONFIGURATION')
lbl1 = input.string('🇬🇧 London', '', inline = 's1_row', group = 'SESSION CONFIGURATION', display = display.none)
c1 = input.color(color.new(#5b9cf6, 85), '', inline = 's1_row', group = 'SESSION CONFIGURATION')
t1 = input.session('0800-1700', '', inline = 's1_row', group = 'SESSION CONFIGURATION')

sN = input.bool(true, '', inline = 's2_row', group = 'SESSION CONFIGURATION')
lbl2 = input.string('🇺🇸 New York', '', inline = 's2_row', group = 'SESSION CONFIGURATION', display = display.none)
c2 = input.color(color.new(#f7525f, 85), '', inline = 's2_row', group = 'SESSION CONFIGURATION')
t2 = input.session('0800-1700', '', inline = 's2_row', group = 'SESSION CONFIGURATION')

sNYSE = input.bool(false, '', inline = 's3_row', group = 'SESSION CONFIGURATION')
lbl3 = input.string('🇺🇸 NYSE', '', inline = 's3_row', group = 'SESSION CONFIGURATION', display = display.none)
c3 = input.color(color.new(#f7525f, 85), '', inline = 's3_row', group = 'SESSION CONFIGURATION')
t3 = input.session('0930-1600', '', inline = 's3_row', group = 'SESSION CONFIGURATION')

sNO = input.bool(true, '', inline = 's4_row', group = 'SESSION CONFIGURATION')
lbl4 = input.string('🇺🇸 NY (eth)', '', inline = 's4_row', group = 'SESSION CONFIGURATION', display = display.none)
c4 = input.color(color.new(#808080, 85), '', inline = 's4_row', group = 'SESSION CONFIGURATION')
t4 = input.session('1600-0930', '', inline = 's4_row', group = 'SESSION CONFIGURATION')

sT = input.bool(true, '', inline = 's5_row', group = 'SESSION CONFIGURATION')
lbl5 = input.string('🇯🇵 Tokyo', '', inline = 's5_row', group = 'SESSION CONFIGURATION', display = display.none)
c5 = input.color(color.new(#FF9800, 85), '', inline = 's5_row', group = 'SESSION CONFIGURATION')
t5 = input.session('0900-1800', '', inline = 's5_row', group = 'SESSION CONFIGURATION')

sTSE = input.bool(false, '', inline = 's6_row', group = 'SESSION CONFIGURATION')
lbl6 = input.string('🇯🇵 TSE', '', inline = 's6_row', group = 'SESSION CONFIGURATION', display = display.none)
c6 = input.color(color.new(#ff9800, 85), '', inline = 's6_row', group = 'SESSION CONFIGURATION')
t6 = input.session('0900-1500', '', inline = 's6_row', group = 'SESSION CONFIGURATION')

sSY = input.bool(true, '', inline = 's7_row', group = 'SESSION CONFIGURATION')
lbl7 = input.string('🇦🇺 Sydney', '', inline = 's7_row', group = 'SESSION CONFIGURATION', display = display.none)
c7 = input.color(color.new(#00BCD4, 85), '', inline = 's7_row', group = 'SESSION CONFIGURATION')
t7 = input.session('0700-1600', '', inline = 's7_row', group = 'SESSION CONFIGURATION')

s8 = input.bool(false, '', inline = 's8_row', group = 'SESSION CONFIGURATION')
z8 = input.string('UTC+1', '', options = ['UTC', 'UTC+0', 'UTC+1', 'UTC+2', 'UTC+3', 'UTC+4', 'UTC+5', 'UTC+6', 'UTC+7', 'UTC+8', 'UTC+9', 'UTC+10', 'UTC+11', 'UTC+12', 'UTC-1', 'UTC-2', 'UTC-3', 'UTC-4', 'UTC-5', 'UTC-6', 'UTC-7', 'UTC-8', 'UTC-9', 'UTC-10', 'UTC-11', 'UTC-12', 'GMT', 'GMT+1', 'GMT+2', 'GMT+3', 'GMT+4', 'GMT+5', 'GMT+6', 'GMT+7', 'GMT+8', 'GMT+9', 'GMT+10', 'GMT+11', 'GMT+12', 'GMT-1', 'GMT-2', 'GMT-3', 'GMT-4', 'GMT-5', 'GMT-6', 'GMT-7', 'GMT-8', 'GMT-9', 'GMT-10', 'GMT-11', 'GMT-12'], inline = 's8_row', group = 'SESSION CONFIGURATION')
c8 = input.color(color.new(#808080, 85), '', inline = 's8_row', group = 'SESSION CONFIGURATION')
t8 = input.session('1700-0800', '', inline = 's8_row', group = 'SESSION CONFIGURATION')

bin_res = input.int(24, 'Volume Profile Resolution (Bins)', minval = 5, maxval = 100, group = 'SESSION TOOLS & CONFIGURATIONS')
max_lvn_bins = 3
master_poc = input.bool(false, 'POC', inline = 'master', group = 'SESSION TOOLS & CONFIGURATIONS')
master_lvn = input.bool(true, 'LVN', inline = 'master', group = 'SESSION TOOLS & CONFIGURATIONS')
master_vwap = input.bool(false, 'VWAP', inline = 'master', group = 'SESSION TOOLS & CONFIGURATIONS')
master_bands = input.bool(false, 'BANDS', inline = 'master', group = 'SESSION TOOLS & CONFIGURATIONS')
showDayLabel = input.bool(true, 'DAYS', inline = 'master', group = 'SESSION TOOLS & CONFIGURATIONS')

color dayDividerCol = color.new(#808080, 30)

z1 = 'Europe/London'
z2 = 'America/New_York'
z3 = 'America/New_York'
z4 = 'America/New_York'
z5 = 'Asia/Tokyo'
z6 = 'Asia/Tokyo'
z7 = 'Australia/Sydney'

src = hlc3
bandColor = color.new(#1a1e28, 0)
bandMult_1 = 1.0
bandMult_2 = 2.0
bandMult_3 = 3.0
MAX_LVN_HIST = 100
MAX_POC_HIST = 100

var array<LVN_Data> active_lvns = array.new<LVN_Data>()
var array<line> historical_pocs = array.new<line>()
var array<float> tmpVP = array.new_float(bin_res, 0.0)

globalChangeInt = ta.change(bar_index)
bool globalBarChanged = not na(globalChangeInt) and globalChangeInt != 0
isNewPeriod = timeframe.change('D')

f_getDayString(int _dayNum) =>
    switch _dayNum
        dayofweek.monday => 'MON'
        dayofweek.tuesday => 'TUE'
        dayofweek.wednesday => 'WED'
        dayofweek.thursday => 'THU'
        dayofweek.friday => 'FRI'
        dayofweek.saturday => ''
        dayofweek.sunday => ''
        => ''

f_isSessionActive(string _sess, string _tz) =>
    int sH = int(str.tonumber(str.substring(_sess, 0, 2)))
    int sM = int(str.tonumber(str.substring(_sess, 2, 4)))
    int eH = int(str.tonumber(str.substring(_sess, 5, 7)))
    int eM = int(str.tonumber(str.substring(_sess, 7, 9)))

    int curH = hour(time, _tz)
    int curM = minute(time, _tz)

    int curVal = curH * 100 + curM
    int startVal = sH * 100 + sM
    int endVal = eH * 100 + eM

    bool active = false
    if startVal < endVal
        active := curVal >= startVal and curVal < endVal
        active
    else
        active := curVal >= startVal or curVal < endVal
        active

    active

f_getSessionEndTime(string _sess, string _tz) =>
    int sH = int(str.tonumber(str.substring(_sess, 0, 2)))
    int sM = int(str.tonumber(str.substring(_sess, 2, 4)))
    int eH = int(str.tonumber(str.substring(_sess, 5, 7)))
    int eM = int(str.tonumber(str.substring(_sess, 7, 9)))

    int curH = hour(time, _tz)
    int curM = minute(time, _tz)

    int curVal = curH * 100 + curM
    int startVal = sH * 100 + sM
    int endVal = eH * 100 + eM

    int y = year(time, _tz)
    int m = month(time, _tz)
    int d = dayofmonth(time, _tz)

    int endTimestamp = na
    if startVal < endVal
        endTimestamp := timestamp(_tz, y, m, d, eH, eM, 0)
        endTimestamp
    else
        if curVal >= startVal
            endTimestamp := timestamp(_tz, y, m, d + 1, eH, eM, 0)
            endTimestamp
        else
            endTimestamp := timestamp(_tz, y, m, d, eH, eM, 0)
            endTimestamp
    endTimestamp

if isNewPeriod and timeframe.isintraday
    line.new(x1 = time, y1 = low, x2 = time, y2 = high, xloc = xloc.bar_time, extend = extend.both, color = dayDividerCol, style = line.style_dashed, width = 1)

    if showDayLabel
        int currentDayNum = dayofweek(time, syminfo.timezone)
        string dayStr = f_getDayString(currentDayNum)
        label.new(x = time, y = na, text = dayStr, xloc = xloc.bar_time, yloc = yloc.abovebar, color = color.new(color.black, 100), textcolor = dayDividerCol, style = label.style_none, size = size.small)

if na(src[1])
    isNewPeriod := true
    isNewPeriod

float vwapValue = na
float upperBandValue1 = na
float lowerBandValue1 = na
float upperBandValue2 = na
float lowerBandValue2 = na
float upperBandValue3 = na
float lowerBandValue3 = na

if master_vwap and not timeframe.isdwm
    [_vwap, _stdevUpper, _] = ta.vwap(src, isNewPeriod, 1)
    vwapValue := _vwap
    stdevAbs = _stdevUpper - _vwap

    upperBandValue1 := _vwap + stdevAbs * bandMult_1
    lowerBandValue1 := _vwap - stdevAbs * bandMult_1
    upperBandValue2 := _vwap + stdevAbs * bandMult_2
    lowerBandValue2 := _vwap - stdevAbs * bandMult_2
    upperBandValue3 := _vwap + stdevAbs * bandMult_3
    lowerBandValue3 := _vwap - stdevAbs * bandMult_3
    lowerBandValue3

plot(vwapValue, title = 'VWAP', color = color.new(bandColor, 0))
displayBands = master_vwap and master_bands ? display.all : display.none

plot(upperBandValue1, title = 'Upper Band #1', color = color.new(bandColor, 80), display = displayBands)
plot(lowerBandValue1, title = 'Lower Band #1', color = color.new(bandColor, 80), display = displayBands)
plot(upperBandValue2, title = 'Upper Band #2', color = color.new(bandColor, 70), display = displayBands)
plot(lowerBandValue2, title = 'Lower Band #2', color = color.new(bandColor, 70), display = displayBands)
plot(upperBandValue3, title = 'Upper Band #3', color = color.new(bandColor, 60), display = displayBands)
plot(lowerBandValue3, title = 'Lower Band #3', color = color.new(bandColor, 60), display = displayBands)

f_manageSession(SessionState state, bool _enabled, bool _hist, string _name, string _sess, string _tz, color _col, bool _showPoc, bool _showLvn, array<float> _dH, array<float> _dL, array<float> _dV, bool _barChanged) =>
    bool inS = _enabled and f_isSessionActive(_sess, _tz)
    color borderColor = color.new(_col, 0)
    color lvnBgColor = color.new(_col, 85)

    float targetLvnTop = na
    float targetLvnBottom = na
    var float INF_TOP = 10e8
    var float INF_BOT = -10e8

    if inS and not state.wasInSession
        state.sHigh := high
        state.sLow := low
        state.startBarIndex := bar_index
        state.startTime := time

        if not _hist
            box.delete(state.sessionBox)
            if not na(state.sessionLabel)
                label.delete(state.sessionLabel)
            line.delete(state.pocLine)
            box.delete(state.lvnBox)

        int initialEndTime = f_getSessionEndTime(_sess, _tz)
        state.sessionBox := box.new(state.startTime, INF_TOP, initialEndTime, INF_BOT, xloc = xloc.bar_time, bgcolor = _col, border_color = color.new(_col, 100))
        state.sessionLabel := _name != '' ? label.new(time, high, _name, xloc = xloc.bar_time, style = label.style_label_down, textcolor = borderColor, color = color.new(color.black, 100), size = size.tiny) : na
        state.pocLine := na
        state.lvnBox := na

        array.clear(state.ltfH)
        array.clear(state.ltfL)
        array.clear(state.ltfV)

    if _enabled
        if inS
            state.sHigh := math.max(state.sHigh, high)
            state.sLow := math.min(state.sLow, low)

            int activeEndTime = f_getSessionEndTime(_sess, _tz)

            box.set_top(state.sessionBox, INF_TOP)
            box.set_bottom(state.sessionBox, INF_BOT)
            box.set_right(state.sessionBox, activeEndTime)

            if _barChanged or barstate.isnew
                int dSize = array.size(_dV)
                if dSize > 0
                    for i = 0 to dSize - 1 by 1
                        array.push(state.ltfH, array.get(_dH, i))
                        array.push(state.ltfL, array.get(_dL, i))
                        array.push(state.ltfV, nz(array.get(_dV, i)))

            if not na(state.sessionLabel)
                int avgTime = math.round(math.avg(state.startTime, time))
                label.set_xy(state.sessionLabel, avgTime, state.sHigh)

            int ltfSize = array.size(state.ltfV)
            if (_showPoc or _showLvn) and ltfSize > 0 and (barstate.isconfirmed or barstate.islast)
                float sessionRange = math.max(syminfo.mintick, state.sHigh - state.sLow)
                float binSize = sessionRange / bin_res
                array.fill(tmpVP, 0.0)

                for j = 0 to ltfSize - 1 by 1
                    float vH = array.get(state.ltfH, j)
                    float vL = array.get(state.ltfL, j)
                    float vV = array.get(state.ltfV, j)
                    float vR = math.max(syminfo.mintick, vH - vL)

                    int topBinIdx = math.max(0, int(math.floor((state.sHigh - vH) / binSize)))
                    int botBinIdx = math.min(bin_res - 1, int(math.floor((state.sHigh - vL) / binSize)))

                    for i = topBinIdx to botBinIdx by 1
                        float bT = state.sHigh - i * binSize
                        float bB = bT - binSize
                        float intersect = math.max(0.0, math.min(vH, bT) - math.max(vL, bB))
                        if intersect > 0
                            array.set(tmpVP, i, array.get(tmpVP, i) + vV * (intersect / vR))

                float maxV = array.max(tmpVP)

                if _showPoc and maxV > 0
                    int pocIdx = array.indexof(tmpVP, maxV)
                    float pocPrice = state.sHigh - pocIdx * binSize - binSize / 2
                    if na(state.pocLine)
                        state.pocLine := line.new(state.startTime, pocPrice, time, pocPrice, xloc = xloc.bar_time, color = borderColor, width = 2)
                        state.pocLine
                    else
                        line.set_xy1(state.pocLine, state.startTime, pocPrice)
                        line.set_xy2(state.pocLine, time, pocPrice)

                if _showLvn and maxV > 0
                    float avgV = array.sum(tmpVP) / bin_res
                    float lvnThreshold = math.min(maxV * 0.25, avgV * 0.60)
                    float minV = maxV
                    int lvnIdx = -1

                    for i = 0 to bin_res - 1 by 1
                        float binVal = array.get(tmpVP, i)
                        if binVal < minV and binVal > 0.0
                            minV := binVal
                            lvnIdx := i
                            lvnIdx

                    if lvnIdx != -1 and minV <= lvnThreshold
                        int startBin = lvnIdx
                        int endBin = lvnIdx
                        int currentSpan = 1

                        while startBin > 0 and currentSpan < max_lvn_bins
                            if array.get(tmpVP, startBin - 1) <= lvnThreshold
                                startBin := startBin - 1
                                currentSpan := currentSpan + 1
                                currentSpan
                            else
                                break

                        while endBin < bin_res - 1 and currentSpan < max_lvn_bins
                            if array.get(tmpVP, endBin + 1) <= lvnThreshold
                                endBin := endBin + 1
                                currentSpan := currentSpan + 1
                                currentSpan
                            else
                                break

                        targetLvnTop := state.sHigh - startBin * binSize
                        targetLvnBottom := state.sHigh - (endBin + 1) * binSize

                        int lvnOriginTime = state.startTime
                        int maxBack = bar_index - state.startBarIndex
                        if maxBack >= 0
                            for k = maxBack to 0 by 1
                                if high[k] >= targetLvnBottom and low[k] <= targetLvnTop
                                    lvnOriginTime := time[k]
                                    break

                        if na(state.lvnBox)
                            state.lvnBox := box.new(lvnOriginTime, targetLvnTop, time, targetLvnBottom, xloc = xloc.bar_time, border_color = borderColor, bgcolor = lvnBgColor)
                            state.lvnBox
                        else
                            box.set_left(state.lvnBox, lvnOriginTime)
                            box.set_top(state.lvnBox, targetLvnTop)
                            box.set_bottom(state.lvnBox, targetLvnBottom)
                            box.set_right(state.lvnBox, time)
                    else
                        box.delete(state.lvnBox)
                        state.lvnBox := na
                        state.lvnBox

        if not inS and state.wasInSession
            if not na(state.pocLine)
                line.set_x2(state.pocLine, time[1])
                if _hist
                    if array.size(historical_pocs) >= MAX_POC_HIST
                        line oldestPoc = array.shift(historical_pocs)
                        line.delete(oldestPoc)
                    array.push(historical_pocs, state.pocLine)
                else
                    line.delete(state.pocLine)
                    state.pocLine := na
                    state.pocLine

            if _showLvn and not na(state.lvnBox)
                float finalTop = box.get_top(state.lvnBox)
                float finalBottom = box.get_bottom(state.lvnBox)
                int finalOriginTime = box.get_left(state.lvnBox)

                box persistentLvn = box.new(finalOriginTime, finalTop, time, finalBottom, xloc = xloc.bar_time, border_color = borderColor, bgcolor = lvnBgColor)

                if array.size(active_lvns) >= MAX_LVN_HIST
                    LVN_Data oldestLvn = array.shift(active_lvns)
                    box.delete(oldestLvn.id)

                array.push(active_lvns, LVN_Data.new(persistentLvn, finalTop, finalBottom, false, _hist))
                box.delete(state.lvnBox)
                state.lvnBox := na
                state.lvnBox

            if not _hist
                box.delete(state.sessionBox)
                if not na(state.sessionLabel)
                    label.delete(state.sessionLabel)
                state.sessionBox := na
                state.sessionLabel := na
                state.sessionLabel

    state.wasInSession := inS
    state.wasInSession

var st1 = SessionState.new(na, na, na, na, 0.0, 0.0, 0, 0, false, array.new_float(0), array.new_float(0), array.new_float(0))
var st2 = SessionState.new(na, na, na, na, 0.0, 0.0, 0, 0, false, array.new_float(0), array.new_float(0), array.new_float(0))
var st3 = SessionState.new(na, na, na, na, 0.0, 0.0, 0, 0, false, array.new_float(0), array.new_float(0), array.new_float(0))
var st4 = SessionState.new(na, na, na, na, 0.0, 0.0, 0, 0, false, array.new_float(0), array.new_float(0), array.new_float(0))
var st5 = SessionState.new(na, na, na, na, 0.0, 0.0, 0, 0, false, array.new_float(0), array.new_float(0), array.new_float(0))
var st6 = SessionState.new(na, na, na, na, 0.0, 0.0, 0, 0, false, array.new_float(0), array.new_float(0), array.new_float(0))
var st7 = SessionState.new(na, na, na, na, 0.0, 0.0, 0, 0, false, array.new_float(0), array.new_float(0), array.new_float(0))
var st8 = SessionState.new(na, na, na, na, 0.0, 0.0, 0, 0, false, array.new_float(0), array.new_float(0), array.new_float(0))

ltf_res = timeframe.isintraday ? timeframe.multiplier <= 15 ? '1' : '5' : timeframe.isdaily ? '15' : '60'
[dH, dL, dV] = request.security_lower_tf(syminfo.tickerid, ltf_res, [high, low, volume])
if not timeframe.isdwm
    f_manageSession(st1, sL, master_hist, '', t1, z1, c1, master_poc, master_lvn, dH, dL, dV, globalBarChanged)
    f_manageSession(st2, sN, master_hist, '', t2, z2, c2, master_poc, master_lvn, dH, dL, dV, globalBarChanged)
    f_manageSession(st3, sNYSE, master_hist, '', t3, z3, c3, master_poc, master_lvn, dH, dL, dV, globalBarChanged)
    f_manageSession(st4, sNO, master_hist, '', t4, z4, c4, master_poc, master_lvn, dH, dL, dV, globalBarChanged)
    f_manageSession(st5, sT, master_hist, '', t5, z5, c5, master_poc, master_lvn, dH, dL, dV, globalBarChanged)
    f_manageSession(st6, sTSE, master_hist, '', t6, z6, c6, master_poc, master_lvn, dH, dL, dV, globalBarChanged)
    f_manageSession(st7, sSY, master_hist, '', t7, z7, c7, master_poc, master_lvn, dH, dL, dV, globalBarChanged)
    f_manageSession(st8, s8, master_hist, '', t8, z8, c8, master_poc, master_lvn, dH, dL, dV, globalBarChanged)

int activeSize = array.size(active_lvns)
if activeSize > 0
    for i = activeSize - 1 to 0 by 1
        LVN_Data lvn = array.get(active_lvns, i)
        bool coreMitigation = high >= lvn.bottom and low <= lvn.top

        if coreMitigation
            if not lvn.sessionHist
                box.delete(lvn.id)
            else
                box.set_right(lvn.id, time)
            array.remove(active_lvns, i)
        else
            box.set_right(lvn.id, time)
